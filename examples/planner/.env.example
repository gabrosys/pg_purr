# examples/planner/.env.example
#
# Copy this file to examples/planner/.env and paste your IBM Quantum
# Platform credentials between the quotes below. The .env file is
# gitignored — do not commit it.
#
# The planner runs on a local AerSimulator by default; setting these
# variables only matters if you want the demo to target real quantum
# hardware via qiskit-ibm-runtime.
#
# How to get a token:
#   1. Sign up at https://quantum.cloud.ibm.com/
#   2. Open the dashboard; the API token appears under your account.
#   3. Paste it below.
#
# Free Open Plan: ~10 minutes of QPU time per 28-day rolling window.
# This demo uses the simulator by default; real-QPU runs are opt-in.

QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
QISKIT_IBM_CHANNEL=ibm_quantum_platform
