# examples/planner/.env.example
#
# Copy this file to examples/planner/.env and paste your IBM Quantum
# Platform credentials between the quotes below. The .env file is
# gitignored — do not commit it.
#
# The planner runs on a local AerSimulator by default; setting these
# variables only matters if you want the demo to target real quantum
# hardware via qiskit-ibm-runtime.
#
# How to get a token:
#   1. Sign up at https://quantum.cloud.ibm.com/
#   2. Open the dashboard; the API token appears under your account.
#   3. Paste it below.
#
# Free Open Plan: ~10 minutes of QPU time per 28-day rolling window.
# This demo uses the simulator by default; real-QPU runs are opt-in.

QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
QISKIT_IBM_CHANNEL=ibm_quantum_platform

# ---------------------------------------------------------------------------
# Planner QAOA tuning (optional). Both variables are read from the
# PostgreSQL server process environment by pg_purr.planner.tree_selector
# and only affect the join-order planner, not the QRNG. They apply to
# both the AerSimulator and IBM-hardware paths.
# ---------------------------------------------------------------------------

# PG_PURR_QAOA_MODE - QAOA execution mode (default: variational).
#   variational - full COBYLA optimisation loop. Submits one QPU job per
#                 energy evaluation; COBYLA's initial simplex sets a floor
#                 of ~(2*reps + 2) jobs, so a single plan call is tens of
#                 queued jobs. On the free Open Plan, Sessions (which would
#                 run those jobs back-to-back) are unavailable, so each job
#                 re-queues independently and one plan can take 30+ minutes.
#   fixed_angle - a single fixed-angle QAOA circuit, executed once: exactly
#                 one QPU job (one queue wait). The angles are not optimised;
#                 the lowest-cost feasible (one-hot) sample is chosen, with a
#                 classical argmin safety net. Recommended for the free Open
#                 Plan and interactive use. (A "fixed-angle" QAOA still runs
#                 a genuine quantum circuit; it just skips the outer loop.)
PG_PURR_QAOA_MODE=fixed_angle

# PG_PURR_QAOA_MAX_ITER - COBYLA iteration cap (default: 80).
# Only applies in 'variational' mode. Each iteration is one QPU job, so
# lowering this conserves IBM Quantum quota/cost. COBYLA clamps it up to
# its simplex floor (~2*reps + 2), so values below ~6 have no effect.
PG_PURR_QAOA_MAX_ITER=10
